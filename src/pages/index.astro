---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TrustNote from '../components/TrustNote.astro';
import { organization } from '../data/organization';
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpeg';
---
<MainLayout>
  <section class="hero shell">
    <div class="hero-copy"><span class="eyebrow">Lalitpur · Uttar Pradesh</span><h1>Together, we can build a <em>better tomorrow.</em></h1><p class="hero-lede">Vijayman Unnatdhara Welfare Foundation is creating a considered, community-led space for service, participation and inclusive development.</p><div class="hero-actions"><a class="button" href="/our-work/">Explore our work <span>↗</span></a><a class="text-link" href="/get-involved/">Find your way to help <span>→</span></a></div></div>
    <div class="hero-art"><div class="hero-ring"><Image src={logo} alt="Vijayman Unnatdhara Welfare Foundation logo" width={520} height={466} loading="eager" fetchpriority="high" decoding="async" /></div><span class="hero-stamp">सेवा ही धर्म<br />सेवा ही कर्म</span><span class="hero-line line-one"></span><span class="hero-line line-two"></span></div>
  </section>
  <section class="marquee" aria-label="Foundation tagline"><div>{organization.tagline} <span>✳</span> {organization.taglineEnglish} <span>✳</span> {organization.tagline}</div></section>
  <section class="section shell intro-grid"><div><span class="section-number">01 / 04</span><SectionHeading eyebrow="Who we are" title="A foundation built on the spirit of service." /></div><div class="intro-body"><p class="lead">Our work begins with a simple belief: lasting progress is shaped with people, not just for them.</p><p>Based in Lalitpur, Uttar Pradesh, Vijayman Unnatdhara Welfare Foundation is building its official platform around openness, participation and responsible social welfare. As the foundation develops its initiatives, this space will make its purpose, people and progress easier to understand.</p><a class="text-link" href="/about/">Get to know us <span>→</span></a></div></section>
  <section class="section section-tint"><div class="shell"><SectionHeading eyebrow="Our direction" title="A clear purpose. An open invitation." text="The statements below are proposed working language and will be replaced by the foundation’s approved mission and vision." /><div class="purpose-grid"><article class="purpose-card purpose-green"><span class="card-mark">↗</span><p class="card-label">Our mission</p><h3>To support meaningful participation and inclusive development through responsible social welfare.</h3><a href="/mission/">Read our mission <span>→</span></a></article><article class="purpose-card purpose-orange"><span class="card-mark">◎</span><p class="card-label">Our vision</p><h3>A more compassionate, empowered and equitable society where communities can shape their own future.</h3><a href="/vision/">Read our vision <span>→</span></a></article></div></div></section>
  <section class="section shell"><SectionHeading eyebrow="A growing platform" title="What we’re preparing to do" text="These are proposed areas of focus, not a list of completed programmes. We will publish confirmed initiatives and outcomes as they become available." /><div class="focus-grid"><article><span>01</span><h3>Education & learning</h3><p>Creating space for learning, opportunity and confidence.</p></article><article><span>02</span><h3>Health & well-being</h3><p>Supporting awareness and a more caring community.</p></article><article><span>03</span><h3>Women’s empowerment</h3><p>Encouraging agency, participation and independence.</p></article><article><span>04</span><h3>Community development</h3><p>Working with people to understand local priorities.</p></article><article><span>05</span><h3>Environmental awareness</h3><p>Connecting everyday action with a healthier future.</p></article><article><span>06</span><h3>Social welfare</h3><p>Responding thoughtfully where support is needed.</p></article></div></section>
  <section class="section dark-section"><div class="shell approach-grid"><div><span class="eyebrow eyebrow-light">Our approach</span><h2>Small steps.<br /><em>Shared ownership.</em></h2></div><div class="approach-list"><div><span>01</span><p><strong>Listen first</strong>Understand community needs before deciding what comes next.</p></div><div><span>02</span><p><strong>Work together</strong>Invite participation from people, volunteers and partners.</p></div><div><span>03</span><p><strong>Stay accountable</strong>Document what happens and share what we learn.</p></div></div></div></section>
  <section class="section shell contact-band"><div><span class="eyebrow">Be part of the story</span><h2>Your time, skills and attention can make room for change.</h2></div><a class="button button-light" href="/get-involved/">Get involved <span>↗</span></a></section>
  <section class="section shell trust-grid"><div><SectionHeading eyebrow="Trust begins with transparency" title="An official presence should answer the important questions." text="We are building a clear record of the foundation’s identity, governance and published work. Verified documents and approved updates will live here as they become available." /><a class="text-link" href="/transparency/">Visit transparency centre <span>→</span></a></div><TrustNote>The CIN, Section 8 licence number and address currently shown in our records were supplied on the foundation’s business card and await independent confirmation.</TrustNote></section>
</MainLayout>
