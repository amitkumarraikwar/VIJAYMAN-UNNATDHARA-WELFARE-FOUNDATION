---
import MainLayout from '../layouts/MainLayout.astro'; import SectionHeading from '../components/SectionHeading.astro'; import { organization } from '../data/organization'; import TrustNote from '../components/TrustNote.astro';
---
<MainLayout title="Contact" description="Contact Vijayman Unnatdhara Welfare Foundation in Lalitpur, Uttar Pradesh." eyebrow="Contact"><section class="section shell"><div class="contact-card"><div><SectionHeading eyebrow="Let’s connect" title="Have a question or an idea?" /><p>We would like to hear from you.</p></div><div><p class="footer-label" style="color:#b8dfbf">Official email</p><a href={`mailto:${organization.email}`} style="font-size:1.15rem">{organization.email}</a><p class="footer-label" style="color:#b8dfbf;margin-top:35px">Location</p><p>{organization.address}</p></div></div><div class="trust-grid"><div><SectionHeading eyebrow="Before you visit" title="Please confirm details by email." /><p class="prose">The supplied business card identifies the foundation in Lalitpur. The exact registered address and any office hours are still being confirmed, so please contact the team before travelling.</p></div><TrustNote>We do not publish a phone number or map pin until the foundation authorizes them.</TrustNote></div></section></MainLayout>
