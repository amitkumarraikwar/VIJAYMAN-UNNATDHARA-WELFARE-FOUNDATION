---
import MainLayout from '../layouts/MainLayout.astro'; import SectionHeading from '../components/SectionHeading.astro'; import { organization } from '../data/organization';
const faqs = [['What is Vijayman Unnatdhara Welfare Foundation?','It is a Section 8 non-profit foundation based in Lalitpur, Uttar Pradesh, according to the organization’s supplied profile.'],['Where is the foundation located?',`The supplied business card identifies ${organization.address}. The exact registered address is awaiting confirmation.`],['Who are the directors?','The supplied business card names Vijay Verma, Durgesh and Omkar Rathore as directors.'],['How can I contact the foundation?',`Email ${organization.email}.`],['Can I donate online?','Online donations are not enabled until verified payment and receipt information is provided.'],['What initiatives does the foundation run?','A confirmed public activity portfolio has not yet been supplied. Proposed focus areas should not be read as completed programmes.']];
---
<MainLayout title="Frequently asked questions" description="Factual answers about Vijayman Unnatdhara Welfare Foundation." eyebrow="FAQs"><section class="section shell"><SectionHeading title="Straight answers, with the right caveats." /><div class="prose" style="max-width:850px;margin-top:50px">{faqs.map(([q,a])=><details style="border-top:1px solid var(--line);padding:22px 0"><summary style="font:700 1.1rem 'Manrope';color:var(--navy);cursor:pointer">{q}</summary><p>{a}</p></details>)}</div></section></MainLayout>
