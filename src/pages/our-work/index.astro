---
import MainLayout from '../../layouts/MainLayout.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import TrustNote from '../../components/TrustNote.astro';
const areas = ['Education and learning','Health and well-being','Women’s empowerment','Community development','Environmental awareness','Social welfare'];
